<script>document.getElementById("wb-demo").srcdoc="<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Under the covers: container-based Workbench<\/title><style>\n:root{\n  --bg:#f5f6f8; --card:#ffffff; --text:#1a2130; --muted:#5a6578; --line:#d8dde6; --accent:#2457c5; --accent-soft:#e4ecfb;\n  --code-bg:#f0f2f6; --term-bg:#10151d; --term-text:#d7deea; --term-dim:#7d8aa0; --ok:#1f7a45; --warn:#b3261e; --warn-soft:#fde8e6; --info-soft:#e8f0fe; --sample:#6b3fa0; --sample-soft:#f1eafa;\n  --edge:#6b7587; --flow:#e0701a;\n  --k-ext-f:#eef0f4; --k-ext-s:#8a93a5;\n  --k-cloud-f:#e1effd; --k-cloud-s:#2b74c4;\n  --k-meta-f:#f1e9fb; --k-meta-s:#7a4fa5;\n  --k-vm-f:#ffffff; --k-vm-s:#4a6fa5;\n  --k-svc-f:#eaf1fb; --k-svc-s:#4a6fa5;\n  --k-agent-f:#fdeee0; --k-agent-s:#c46a1a;\n  --k-cont-f:#e5f5ea; --k-cont-s:#2f8a4f;\n  --k-disk-f:#fff6dc; --k-disk-s:#b8921e;\n  --k-warn-f:#fde4e2; --k-warn-s:#c43a3a;\n  --k-sample-f:#f4edfb; --k-sample-s:#8250c4;\n  --k-state-f:#ffffff; --k-state-s:#2457c5;\n  --node-text:#1a2130; --node-sub:#4d586b; --frame:#99a3b5;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"]{\n  --bg:#0e1218; --card:#161c26; --text:#e6e9f0; --muted:#98a3b8; --line:#2a3342; --accent:#7aa2ff; --accent-soft:#1d2a47;\n  --code-bg:#1d2431; --term-bg:#090c11; --term-text:#d7deea; --term-dim:#7d8aa0; --ok:#5fd08a; --warn:#ff8a80; --warn-soft:#3a1d1b; --info-soft:#1b2740; --sample:#c2a0f0; --sample-soft:#2a2038;\n  --edge:#8793a8; --flow:#ffa24d;\n  --k-ext-f:#212837; --k-ext-s:#7d889c;\n  --k-cloud-f:#142a44; --k-cloud-s:#5aa3f0;\n  --k-meta-f:#2a2038; --k-meta-s:#b58be0;\n  --k-vm-f:#161c26; --k-vm-s:#7aa2ff;\n  --k-svc-f:#1b2740; --k-svc-s:#7aa2ff;\n  --k-agent-f:#3a2615; --k-agent-s:#ff9f55;\n  --k-cont-f:#17301f; --k-cont-s:#5fd08a;\n  --k-disk-f:#352c10; --k-disk-s:#e0b840;\n  --k-warn-f:#3a1d1b; --k-warn-s:#ff7a70;\n  --k-sample-f:#2a2038; --k-sample-s:#c2a0f0;\n  --k-state-f:#161c26; --k-state-s:#7aa2ff;\n  --node-text:#e6e9f0; --node-sub:#a9b3c6; --frame:#4a5568;\n  color-scheme: dark;\n}\n@media (prefers-color-scheme: dark){\n  :root:not([data-theme=\"light\"]){\n    --bg:#0e1218; --card:#161c26; --text:#e6e9f0; --muted:#98a3b8; --line:#2a3342; --accent:#7aa2ff; --accent-soft:#1d2a47;\n    --code-bg:#1d2431; --term-bg:#090c11; --ok:#5fd08a; --warn:#ff8a80; --warn-soft:#3a1d1b; --info-soft:#1b2740; --sample:#c2a0f0; --sample-soft:#2a2038;\n    --edge:#8793a8; --flow:#ffa24d;\n    --k-ext-f:#212837; --k-ext-s:#7d889c; --k-cloud-f:#142a44; --k-cloud-s:#5aa3f0; --k-meta-f:#2a2038; --k-meta-s:#b58be0;\n    --k-vm-f:#161c26; --k-vm-s:#7aa2ff; --k-svc-f:#1b2740; --k-svc-s:#7aa2ff; --k-agent-f:#3a2615; --k-agent-s:#ff9f55;\n    --k-cont-f:#17301f; --k-cont-s:#5fd08a; --k-disk-f:#352c10; --k-disk-s:#e0b840; --k-warn-f:#3a1d1b; --k-warn-s:#ff7a70;\n    --k-sample-f:#2a2038; --k-sample-s:#c2a0f0; --k-state-f:#161c26; --k-state-s:#7aa2ff;\n    --node-text:#e6e9f0; --node-sub:#a9b3c6; --frame:#4a5568; color-scheme: dark;\n  }\n}\n[hidden]{display:none!important}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:64px}\nbody{margin:0;background:var(--bg);color:var(--text);font:15px/1.6 system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\na{color:var(--accent)}\ncode,pre,kbd{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}\ncode{background:var(--code-bg);padding:.1em .38em;border-radius:5px;font-size:.88em}\nh1,h2,h3{line-height:1.25;margin:0 0 .5em}\nh1{font-size:clamp(1.7rem,3.2vw,2.5rem);letter-spacing:-.01em}\nh2{font-size:1.55rem;margin-top:0}\nh3{font-size:1.12rem;margin-top:1.6em}\np{margin:.5em 0 1em}\n.wrap{max-width:1240px;margin:0 auto;padding:0 20px}\nsection{padding:44px 0;border-top:1px solid var(--line)}\nsection:first-of-type{border-top:0}\n.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\n.nav .wrap{display:flex;align-items:center;gap:6px;height:52px;overflow-x:auto;white-space:nowrap}\n.nav b{margin-right:10px}\n.nav a{text-decoration:none;color:var(--muted);padding:6px 10px;border-radius:8px;font-size:.92rem}\n.nav a:hover{background:var(--accent-soft);color:var(--accent)}\n.nav .sp{flex:1}\nbutton,select{font:inherit;color:var(--text)}\n.btn{background:var(--card);border:1px solid var(--line);padding:7px 14px;border-radius:9px;cursor:pointer;display:inline-flex;gap:7px;align-items:center}\n.btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.primary:hover:not(:disabled){color:#fff;filter:brightness(1.08)}\n.lead{font-size:1.1rem;color:var(--muted);max-width:860px}\n.chips{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0}\n.chip{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 14px;min-width:150px}\n.chip b{display:block;font-size:1.25rem}\n.chip span{color:var(--muted);font-size:.84rem}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px}\n.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:18px}\n.tbl{overflow-x:auto;margin:10px 0 22px;border:1px solid var(--line);border-radius:12px;background:var(--card)}\ntable{border-collapse:collapse;width:100%;font-size:.9rem}\nth,td{padding:8px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}\nth{background:var(--code-bg);font-weight:600;white-space:nowrap}\ntr:last-child td{border-bottom:0}\n.tag{display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.02em;padding:1px 8px;border-radius:99px;border:1px solid var(--line);vertical-align:middle;margin-right:6px;text-transform:uppercase}\n.tag.obs{background:var(--info-soft);color:var(--accent);border-color:transparent}\n.tag.inf{background:#fff4d6;color:#8a6100;border-color:transparent}\n:root[data-theme=\"dark\"] .tag.inf{background:#3a3114;color:#e8c55a}\n.tag.smp{background:var(--sample-soft);color:var(--sample);border-color:transparent}\n.tag.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}\n.callout{border-left:4px solid var(--accent);background:var(--info-soft);padding:10px 14px;border-radius:0 10px 10px 0;margin:12px 0}\n.callout.warn{border-color:var(--warn);background:var(--warn-soft)}\n.callout.smp{border-color:var(--sample);background:var(--sample-soft)}\n.callout p{margin:.2em 0}\npre{background:var(--term-bg);color:var(--term-text);padding:14px 16px;border-radius:12px;overflow:auto;font-size:.82rem;line-height:1.5;margin:10px 0 18px}\n.pre-wrap{position:relative}\n.copy{position:absolute;top:8px;right:8px;font-size:.75rem;padding:3px 10px}\n.diag{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;overflow:auto;margin:12px 0 6px}\n.diag svg{display:block;margin:0 auto;max-width:100%;height:auto}\n.cap{color:var(--muted);font-size:.88rem;margin:0 0 26px}\n\n/* ---------- demo ---------- */\n.demo-bar{position:sticky;top:52px;z-index:40;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin:12px 0;display:flex;flex-wrap:wrap;gap:10px;align-items:center}\n.demo-bar .grow{flex:1}\n.demo-bar label{font-size:.85rem;color:var(--muted);display:inline-flex;gap:6px;align-items:center;cursor:pointer}\n.demo-bar select{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px 8px}\n.tabs{display:flex;gap:8px;overflow-x:auto;margin:14px 0 4px;padding-bottom:4px}\n.tab{flex:1 0 148px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 12px;cursor:pointer;display:flex;flex-direction:column;gap:2px;color:var(--muted);font:inherit}\n.tab b{color:var(--text);font-size:.9rem}.tab span{font-size:.76rem}\n.tab:hover{border-color:var(--accent)}\n.tab.cur{background:var(--accent);border-color:var(--accent);color:#e8f0ff}.tab.cur b{color:#fff}\n.stepno{font-variant-numeric:tabular-nums;color:var(--muted);font-size:.9rem;min-width:84px;text-align:right}\n.dots{display:flex;gap:5px;flex-wrap:wrap;width:100%}\n.dot{width:26px;height:26px;border-radius:8px;border:1px solid var(--line);background:var(--card);font-size:.72rem;cursor:pointer;color:var(--muted);padding:0}\n.dot.done{background:var(--accent-soft);color:var(--accent);border-color:transparent}\n.dot.cur{background:var(--accent);color:#fff;border-color:var(--accent)}\n.dot.smp{border-style:dashed;border-color:var(--sample)}\n.stage-wrap{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:8px;overflow:auto}\n#stage{display:block;width:100%;min-width:560px;height:auto}\n.timeline{display:flex;gap:4px;margin:12px 0 0;font-size:.74rem}\n.seg{flex:1 1 0;min-width:0;border:1px solid var(--line);background:var(--card);border-radius:8px;padding:5px 7px;color:var(--muted);transition:all .3s}\n.seg b{display:block;color:var(--text);font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.seg.done{background:var(--accent-soft);border-color:transparent}\n.seg.cur{background:var(--accent);color:#e8f0ff;border-color:var(--accent)}\n.seg.cur b{color:#fff}\n.seg.pull{flex-grow:3}\n#demo .wrap{max-width:1600px}\n.demo-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,420px);gap:16px;align-items:start}\n.demo-main{min-width:0}\n.demo-side{position:sticky;top:176px;max-height:calc(100vh - 192px);display:flex;flex-direction:column;gap:12px;min-width:0}\n.demo-side .caption{flex:1 1 56%;min-height:0;overflow:auto;padding:14px 16px}\n.demo-side .caption h3{font-size:1.1rem;margin:.1em 0 .5em}\n.demo-side .caption li{font-size:.9rem;margin:.3em 0}\n.demo-side .term{flex:1 1 44%;min-height:0;max-height:none}\n.demo-side .term pre{overflow:auto;font-size:.76rem}\n.demo-side .caption .callout{font-size:.86rem}\n@media (max-width:1050px){.demo-grid{grid-template-columns:1fr}.demo-side{position:static;max-height:none}.demo-side .caption,.demo-side .term{overflow:visible}}\n.panels{display:grid;grid-template-columns:minmax(300px,5fr) minmax(300px,6fr);gap:16px;margin-top:16px}\n@media (max-width:900px){.panels{grid-template-columns:1fr}}\n.caption{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;min-height:260px}\n.caption .meta{display:flex;gap:8px;align-items:center;margin-bottom:6px;color:var(--muted);font-size:.84rem}\n.pill{border:1px solid var(--line);border-radius:99px;padding:1px 10px;background:var(--code-bg)}\n.caption h3{margin:.1em 0 .6em;font-size:1.25rem}\n.caption ul{margin:.3em 0 .6em;padding-left:1.2em}\n.caption li{margin:.35em 0}\n.caption .callout{font-size:.9rem}\n.term{background:var(--term-bg);color:var(--term-text);border-radius:14px;overflow:hidden;border:1px solid #000;display:flex;flex-direction:column;min-height:260px;max-height:520px}\n.term-h{display:flex;gap:7px;align-items:center;padding:8px 12px;background:#1a212d;color:var(--term-dim);font-size:.78rem}\n.term-h i{width:10px;height:10px;border-radius:50%;display:inline-block;background:#3a4558}\n.term-h span{margin-left:6px}\n.term pre{margin:0;border-radius:0;background:transparent;flex:1;font-size:.8rem;white-space:pre-wrap;word-break:break-word}\n.term .ln{display:block;animation:fadein .35s both}\n.term .c{color:#8fd0ff}.term .d{color:var(--term-dim)}.term .g{color:#7fe3a0}.term .r{color:#ff8f86}\n@keyframes fadein{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}\n.bar{height:8px;background:var(--code-bg);border-radius:99px;overflow:hidden;margin:6px 0 4px}\n.bar i{display:block;height:100%;width:0;background:var(--flow);border-radius:99px}\n.bar.run i{animation:fill 5s linear forwards}\n@keyframes fill{to{width:100%}}\n\n/* svg stage */\n#stage .node,#stage .edge,#stage .lbl,#stage .frame{opacity:0;transition:opacity .55s ease;pointer-events:none}\n#stage .on{opacity:1}\n#stage.hasfocus .node.on:not(.focus){opacity:.5}\n#stage .node rect{stroke-width:1.6;rx:10}\n#stage .node .t{fill:var(--node-text);font:600 12.5px system-ui,sans-serif}\n#stage .node .s{fill:var(--node-sub);font:10px system-ui,sans-serif}\n#stage .node.focus rect{stroke:var(--accent)!important;stroke-width:3.2;animation:glow 1.4s ease-in-out infinite}\n@keyframes glow{50%{filter:drop-shadow(0 0 7px var(--accent))}}\n.k-ext rect{fill:var(--k-ext-f);stroke:var(--k-ext-s)}\n.k-cloud rect{fill:var(--k-cloud-f);stroke:var(--k-cloud-s)}\n.k-meta rect{fill:var(--k-meta-f);stroke:var(--k-meta-s)}\n.k-vm rect{fill:var(--k-vm-f);stroke:var(--k-vm-s)}\n.k-host rect{fill:var(--k-ext-f);stroke:var(--frame)}\n.k-svc rect{fill:var(--k-svc-f);stroke:var(--k-svc-s)}\n.k-agent rect{fill:var(--k-agent-f);stroke:var(--k-agent-s)}\n.k-cont rect{fill:var(--k-cont-f);stroke:var(--k-cont-s)}\n.k-disk rect{fill:var(--k-disk-f);stroke:var(--k-disk-s)}\n.k-warn rect{fill:var(--k-warn-f);stroke:var(--k-warn-s)}\n.k-sample rect{fill:var(--k-sample-f);stroke:var(--k-sample-s);stroke-dasharray:6 4}\n.k-state rect{fill:var(--k-state-f);stroke:var(--k-state-s)}\n#stage .frame rect{fill:none;stroke:var(--frame);stroke-width:1.4;stroke-dasharray:3 5;rx:16}\n#stage .frame text,#stage .lbl text{fill:var(--muted);font:600 11px system-ui,sans-serif}\n#stage .edge .line{fill:none;stroke:var(--edge);stroke-width:1.6;stroke-linejoin:round}\n#stage marker .arrow{fill:var(--edge)}\n#stage .edge text{fill:var(--muted);font:10px system-ui,sans-serif;paint-order:stroke;stroke:var(--card);stroke-width:4px;stroke-linejoin:round}\n#stage .edge.sample .line{stroke:var(--k-sample-s);stroke-dasharray:5 4}\n#stage .edge.flow .line{stroke:var(--flow);stroke-width:2.6;stroke-dasharray:7 6;animation:dash .7s linear infinite}\n@keyframes dash{to{stroke-dashoffset:-13}}\n@media (prefers-reduced-motion: reduce){#stage .edge.flow .line,#stage .node.focus rect,.term .ln{animation:none}}\nfooter{padding:36px 0 60px;color:var(--muted);font-size:.86rem;border-top:1px solid var(--line)}\n.kbd{display:inline-block;border:1px solid var(--line);border-bottom-width:2px;border-radius:6px;padding:0 6px;font-size:.78rem;background:var(--card)}\n<\/style><style>.nav,.hero{display:none}body{margin:0}section{border:0!important;padding-top:8px!important}<\/style><\/head><body><main><section id=\"demo\"><div class=\"wrap\">\n  <h2>Demo: what happens under the covers, from a clean slate<\/h2>\n  <p>Five scenes tell one story: <b>build the VM<\/b> (Notebooks API \u2192 Compute API), <b>where the images come from<\/b>, <b>boot<\/b>, <b>metadata<\/b>, and <b>disks<\/b>. Press <b>Play<\/b> to run the whole tour, step with <b>Next<\/b> and <b>Back<\/b> (they cross scene boundaries), or jump with the tabs. <b>Reset<\/b> returns to the empty slate. Keyboard: <span class=\"kbd\">Space<\/span> play/pause, <span class=\"kbd\">\u2190<\/span> <span class=\"kbd\">\u2192<\/span> back/next, <span class=\"kbd\">Home<\/span> reset. Every step replays exactly, so Back really rewinds.<\/p>\n\n  <div class=\"tabs\" id=\"tabs\" role=\"tablist\" aria-label=\"Scenes\"><\/div>\n  <div class=\"demo-bar\" id=\"controls\">\n    <button class=\"btn\" id=\"b-reset\" type=\"button\" title=\"Reset to clean slate\">\u27f2 Reset<\/button>\n    <button class=\"btn\" id=\"b-back\" type=\"button\" title=\"Previous step\">\u25c0 Back<\/button>\n    <button class=\"btn primary\" id=\"b-play\" type=\"button\" title=\"Play / pause\">\u25b6 Play<\/button>\n    <button class=\"btn\" id=\"b-next\" type=\"button\" title=\"Next step\">Next \u25b6<\/button>\n    <label>Speed\n      <select id=\"speed\"><option value=\"7000\">Slow<\/option><option value=\"4800\" selected>Normal<\/option><option value=\"2800\">Fast<\/option><\/select>\n    <\/label>\n    <label id=\"sample-wrap\" title=\"Boot scene only: adds a step that runs an illustrative post-startup script (gcsfuse + rsync)\"><input type=\"checkbox\" id=\"sample\" checked> Include sample post-startup script<\/label>\n    <span class=\"grow\"><\/span>\n    <span class=\"stepno\" id=\"stepno\">Step 0 / 0<\/span>\n    <div class=\"dots\" id=\"dots\" role=\"tablist\" aria-label=\"Steps\"><\/div>\n  <\/div>\n\n  <div class=\"demo-grid\"><div class=\"demo-main\"><div class=\"stage-wrap\"><svg id=\"stage\" viewBox=\"0 0 1300 722\" role=\"img\" aria-label=\"Animated architecture diagram of the Workbench VM boot\"><\/svg><\/div>\n  <div class=\"timeline\" id=\"timeline\" aria-hidden=\"true\"><\/div>\n  <p class=\"cap\" id=\"timeline-note\">Timeline is illustrative and not to scale. Real durations vary; the image pull is usually the longest step.<\/p>\n\n  <\/div><div class=\"demo-side\" id=\"side\">\n    <article class=\"caption\" id=\"caption\" aria-live=\"polite\"><\/article>\n    <aside class=\"term\"><div class=\"term-h\"><i><\/i><i><\/i><i><\/i><span id=\"term-title\">evidence<\/span><\/div><pre id=\"term\"><\/pre><\/aside>\n  <\/div><\/div>\n<\/div><\/section><\/main><button id=\"theme\" hidden><\/button><script type=\"text/plain\" id=\"ev-s0\">\n$ gcloud workbench instances create my-instance \\\n    --project my-project --location ZONE \\\n    --container-repository=REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE \\\n    --container-tag=latest --metadata=idle-timeout-seconds=3600\n\n# before: no VM, no disks, no containers\n# after (roughly ten minutes later): an ACTIVE instance and a JupyterLab URL\n<\/script><script type=\"text/plain\" id=\"ev-s1\">\n$ gcloud compute disks describe my-instance-boot\nsourceImage: projects/cloud-notebooks-managed/global/images/\n             workbench-container-host-BUILD_TAG\nlicenses:    cos-cloud/.../licenses/cos\n             click-to-deploy-images/.../c2d-dl-platform-workbench-instances-custom-container-host\nsizeGb: (your choice)   # plus a data disk my-instance-data-workspace\n\n# instance metadata written by the API (excerpt)\ncustom-container-payload: REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\nnotebooks-api-version:    v2\nproxy-backend-id:         BACKEND_ID\nidle-timeout-seconds:     3600\nuser-data:                #include file:///mnt/stateful_partition/workbench/cloud-config.yaml\n<\/script><script type=\"text/plain\" id=\"ev-s2\">\n$ systemd-analyze\nStartup finished in a few seconds (kernel) + several minutes (userspace)\n\n$ grep PRETTY /etc/os-release\nPRETTY_NAME=\"Container-Optimized OS from Google\"\n$ uname -r\n6.x.y+\n$ lsblk\nsda3 -> vroot  ~2G  dm  /                  # read-only, dm-verity\nsda1  (most of the disk)  /mnt/stateful_partition  (also /var)\n<\/script><script type=\"text/plain\" id=\"ev-s3\">\n# user-data -> /mnt/stateful_partition/workbench/cloud-config.yaml\nusers:\n  - jupyter        (uid 2000)\n  - executoragent  (uid 2001, group docker)\nwrite_files:\n  /etc/systemd/system/workbench-configure.service\n  /etc/systemd/system/jupyter-payload.service\n  /etc/systemd/system/workbench-proxy-agent.service   ... about 20 units\n  /mnt/stateful_partition/workbench/*.sh\nruncmd:\n  - /etc/systemd/system/startup.sh\n\n$ systemd-analyze critical-chain          # typical shape\ncloud-init.service   @ ~15-20 s\ncloud-final.service  @ ~20 s  + several minutes   <- runs startup.sh\n<\/script><script type=\"text/plain\" id=\"ev-s4\">\n# /etc/systemd/system/startup.sh  (run by cloud-final, in this order)\nsystemctl start log-systemd-services.service\nsystemctl start workbench-configure riptide-init disable-ssh-access \\\n                disable-gce-startup-scripts workbench-mount-disk\nsystemctl start gcfsd snapshotter ; systemctl restart containerd\nsystemctl start pull-custom-container-payload.service\nsystemctl start workbench-euc-metadata.service\nsystemctl start jupyter-payload.service\nsystemctl start workbench-euc-agent.service maybe-initialize-executor.service\nsystemctl start workbench-proxy-agent workbench-idle-shutdown-agent \\\n                workbench-health-agent workbench-diagnostic-service\nsystemctl start opencode.service            # optional extras, depends on the image\nsystemctl start euc-initialization.service\nsystemctl start run-post-startup.service\nsystemctl start workbench-cleanup.service\n<\/script><script type=\"text/plain\" id=\"ev-s5\">\n# workbench-configure.service\ndocker run --rm --name=workbench-configure \\\n  -v /etc/:/etc/ -v /mnt/stateful_partition/workbench:/mnt/stateful_partition/workbench \\\n  --mount type=bind,source=/etc/systemd/system,target=/mnt/systemd \\\n  --mount type=bind,source=/tmp,target=/tmp \\\n  vertex/workbench-instances-agent:local ./service_generator_agent\n\n$ cat /tmp/ENV_INFO     (typical excerpt, values are placeholders)\nWORKBENCH_CUSTOM_CONTAINER_PAYLOAD=REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\nPROJECT_ID=my-project            INSTANCE_REGION=REGION\nBACKEND_ID=BACKEND_ID            PAYLOAD_CONTAINER_ADDRESS=127.0.0.1:8080\nCONTAINER_USER=0:0               JUPYTER_USER=jupyter\nALLOW_FUSE_FLAG=--device /dev/fuse --cap-add SYS_ADMIN --security-opt apparmor:unconfined\nDOCKER_RUN_CUSTOM_PARAMS=        ENV_FILE_FLAG=            # empty unless you set the keys\nRUN_POST_STARTUP_SCRIPT=False\n<\/script><script type=\"text/plain\" id=\"ev-s6\">\n# mount-disk.sh (excerpt)\nmount_data_disk                    # /dev/disk/by-id/google-data-workspace -> /home/jupyter\nsudo mount -o remount,exec \"/home/${JUPYTER_USER}\"\n# if the owner is not CONTAINER_USER (0:0):\nsudo chown -R \"${CONTAINER_USER}\" \"/home/${JUPYTER_USER}\"\n\n$ findmnt /home/jupyter\nTARGET         SOURCE    FSTYPE  OPTIONS\n/home/jupyter  /dev/sdb  ext4    rw,relatime,discard\n<\/script><script type=\"text/plain\" id=\"ev-s7\">\n# /etc/containerd/config.toml (excerpt)\n[plugins.'io.containerd.cri.v1.images']\n  snapshotter = \"gcfs\"\n  discard_unpacked_layers = true\n[proxy_plugins.gcfs]\n  type = \"snapshot\"\n  address = \"/run/containerd-gcfs-grpc/containerd-gcfs-grpc.sock\"\n\n$ findmnt /run/gcfsd/mnt\nTARGET          SOURCE  FSTYPE\n/run/gcfsd/mnt  gcfsd   fuse.gcfsd\n\n$ systemctl is-active gcfsd snapshotter riptide-init\nactive\nactive\nactive\n<\/script><script type=\"text/plain\" id=\"ev-s8\">\nStarting pull-custom-container-payload.service...\nAuthenticating with Artifact Registry\ndocker run vertex/gcloud:local gcloud auth list\n...\ncrictl pull --creds oauth2accesstoken:<token> \\\n  REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\n\n# first boot only: /home/jupyter is empty, so copy the image's /home onto the data disk\nnerdctl --snapshotter=gcfs -n k8s.io create --net none <image>\ncp -p -r \"<image home>/.\" /home/jupyter\n\njupyter-payload.service starts          # typically several minutes after the pull began\n<\/script><script type=\"text/plain\" id=\"ev-s9\">\n/var/lib/google/nerdctl/nerdctl --snapshotter=gcfs -n k8s.io run --name payload-container \\\n  -p 127.0.0.1:8080:8080/tcp --env=NUM_GPUS=0 --env=EUC_ENABLED=False \\\n  --device /dev/fuse --cap-add SYS_ADMIN --security-opt apparmor:unconfined \\\n  --user 0:0 -e VERTEX_PRODUCT=WORKBENCH_CUSTOM_CONTAINER \\\n  -e GOOGLE_CLOUD_PROJECT=my-project -e GOOGLE_CLOUD_REGION=REGION \\\n  -w /home/jupyter -v /home/jupyter:/home/jupyter  <YOUR_IMAGE:latest>\n\n$ ps --forest\ncontainerd-shim-runc-v2 -namespace k8s.io -id <container id>...\n  /bin/bash /run_jupyter.sh                          # PID 1 in the container\n    jupyter-lab --allow-root --ip 0.0.0.0 ...        # listens on 0.0.0.0:8080\n$ nerdctl -n k8s.io ps\npayload-container   127.0.0.1:8080->8080/tcp          # container IP on the nerdctl0 bridge\n<\/script><script type=\"text/plain\" id=\"ev-s10\">\ndocker run --name=proxy-agent --restart always --net host \\\n  --env BACKEND=BACKEND_ID \\\n  --env PROXY=$PROXY_REGISTRATION_URL/ \\\n  --env HOSTNAME=127.0.0.1 --env PORT=8080 \\\n  --env PROXY_TIMEOUT=60s --env REQUEST_FORWARDING_TIMEOUT=1h \\\n  vertex/inverting-proxy-agent:local\n\nproxy-agent log:\nRequest forwarding timeout is 1h0m0s; proxy timeout is 1m0s\n\n$ iptables -t nat -S | grep CNI-HOSTPORT-DNAT\n# 127.0.0.1:8080 on the host -> <container IP>:8080 in the container\n<\/script><script type=\"text/plain\" id=\"ev-s11\">\nidle-shutdown-agent  ./idle_shutdown_agent --jupyter_address=127.0.0.1:8080\nhealth-agent         ./notebooks_collection_agent --jupyter_address=127.0.0.1:8080 \\\n                       --docker_container_check_list=idle-shutdown-agent,diagnostic-service,proxy-agent\ndiagnostic-service   --privileged --pid host   ./diagnostic_tool --poll\n\nhealth-agent log:\nReporting url: https://notebooks.googleapis.com/v2/projects/my-project/locations/\n  ZONE/instances/my-instance:reportInfoSystem, with event type: HEALTH\nResponse: <Response [200]>                 # about every 30 s\n<\/script><script type=\"text/plain\" id=\"ev-s12\">\n# what to check on the host\n$ sudo ss -ltnp\n0.0.0.0:22     sshd\n127.0.0.1:8080 jupyter (via port-forward)\n0.0.0.0:<high port>   <optional extra service>     # review: does it need auth?\n\n# an extra service may log something like:\n!  <SERVICE>_PASSWORD is not set; server is unsecured.\n\n# to stop one until the next reboot:\n$ sudo systemctl stop <unit>\n<\/script><script type=\"text/plain\" id=\"ev-s13\">\n# /mnt/stateful_partition/workbench/run_post_startup_script.sh\nif [[ \"${RUN_POST_STARTUP_SCRIPT}\" == \"True\" ]]; then\n  chmod +x \"${POST_STARTUP_SCRIPT_PATH}\"\n  /bin/bash -c \"${POST_STARTUP_SCRIPT_PATH}\"\nfi\n\n# with no script set:  RUN_POST_STARTUP_SCRIPT=False  ->  nothing runs\n\n# workbench-cleanup (runs right after)\ndocker volume prune -af\nnerdctl -n k8s.io volume prune -af\nnerdctl -n k8s.io images prune -a\n<\/script><script type=\"text/plain\" id=\"ev-s14\">\n$ systemd-analyze\nmulti-user.target reached after several minutes in userspace.\n\nhealth-agent -> Notebooks API:  Response: <Response [200]>\n\nInstance state:   PROVISIONING -> ACTIVE        # roughly ten minutes after create\n<\/script><script type=\"text/plain\" id=\"ev-s15\">\nhttps://BACKEND_ID-dot-REGION.notebooks.googleusercontent.com\n\nproxy-agent log:\nWebsocket connection to the server \"ws://127.0.0.1:8080/api/events/subscribe\"\n  established for session: 1\n\n$ curl -s http://127.0.0.1:8080/api\n{\"version\": \"2.x.y\"}                       # Jupyter Server, via host loopback\n\n# from inside payload-container:\n$ curl -s -H 'Metadata-Flavor: Google' \\\n    http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email\nPROJECT_NUMBER-compute@developer.gserviceaccount.com\n<\/script><script type=\"text/plain\" id=\"ev-s16\">\n$ gcloud compute operations list --filter='targetLink~my-instance'\nTIME  stop  my-instance  service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com  DONE\n# the principal is the Notebooks service agent, not a user\n\n$ gcloud compute instances describe my-instance --format='value(status,lastStopTimestamp)'\nTERMINATED   <timestamp>        # typically about idle-timeout-seconds after the last activity\n\n# on stop, jupyter-payload ExecStopPost runs:\n/mnt/stateful_partition/workbench/shutdown_script.sh   ->  clean_up_gfuse_mounts\n<\/script><script type=\"text/plain\" id=\"ev-a0\">\n$ gcloud workbench instances list --project my-project --location ZONE\nListed 0 items.\n\n# no instance, and no disks named my-instance-*, exist yet\n<\/script><script type=\"text/plain\" id=\"ev-a1\">\n$ gcloud workbench instances create my-instance \\\n    --project my-project --location ZONE \\\n    --container-repository=REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE \\\n    --container-tag=latest --metadata=idle-timeout-seconds=3600\n\n# gcloud turns that into (illustrative, simplified):\nPOST https://notebooks.googleapis.com/v2/projects/my-project/locations/ZONE/instances?instanceId=my-instance\n{ \"gceSetup\": { \"containerImage\": { \"repository\": \"REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE\",\n                                    \"tag\": \"latest\" },\n                \"metadata\": { \"idle-timeout-seconds\": \"3600\" } } }\n<\/script><script type=\"text/plain\" id=\"ev-a2\">\nWaiting for operation on Instance [my-instance] to be created with\n[projects/my-project/locations/ZONE/operations/operation-...]...\n.........done.\nCreated workbench instance my-instance\n\n# defaults the API fills in (visible later in `gcloud workbench instances describe`):\nmachineType: a standard type     bootDisk: PD_STANDARD     dataDisks: PD_STANDARD\nnetwork: default   subnet: default   serviceAccount: PROJECT_NUMBER-compute@developer.gserviceaccount.com\ntags: deeplearning-vm, notebook-instance      metadata: about two dozen keys\n<\/script><script type=\"text/plain\" id=\"ev-a3\">\n$ gcloud compute operations list --filter='targetLink~my-instance'\nTYPE: insert   TARGET: my-instance\nUSER: service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com\nSTATUS: DONE\n\n# the caller is the Notebooks service agent of your project, not a person\n<\/script><script type=\"text/plain\" id=\"ev-a4\">\n$ gcloud compute instances describe my-instance\ncreationTimestamp: <t>\nmy-instance-boot            created <t>+ms    sourceImage .../cloud-notebooks-managed/.../workbench-container-host-BUILD_TAG\nmy-instance-data-workspace  created <t>+ms    blank\nnic0: network default, subnetwork default, networkIP 10.x.x.x, ONE_TO_ONE_NAT (PREMIUM)\nserviceAccounts: PROJECT_NUMBER-compute@developer.gserviceaccount.com  [cloud-platform, userinfo.email]\nshieldedInstanceConfig: enableVtpm true, enableIntegrityMonitoring true\nlabels: notebooks-product=workbench-instances  resource-name=my-instance  consumer-project-id=my-project\n<\/script><script type=\"text/plain\" id=\"ev-a5\">\n$ gcloud compute operations list --filter='targetLink~my-instance' --sort-by=insertTime\nTYPE         TARGET       USER (principal)\ninsert       my-instance  service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com   DONE\nsetMetadata  my-instance  service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com   DONE\nstop         my-instance  service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com   DONE   # e.g. idle stop\n<\/script><script type=\"text/plain\" id=\"ev-a6\">\n# shortly after the VM starts, a setMetadata call by the service agent usually appears\n\n# metadata keys present afterwards include:\nproxy-url  proxy-backend-id  proxy-registration-url  proxy-mode  report-event-url\n# the operation record does not say which keys the call changed\n<\/script><script type=\"text/plain\" id=\"ev-a7\">\nstop  my-instance  service-PROJECT_NUMBER@gcp-sa-notebooks.iam.gserviceaccount.com  DONE\n\n$ gcloud compute instances describe my-instance --format='value(status,lastStopTimestamp)'\nTERMINATED   <timestamp>\n\n# idle-timeout-seconds (default 10800, i.e. 3 hours) controls when this fires\n<\/script><script type=\"text/plain\" id=\"ev-a8\">\n$ gcloud compute instances describe my-instance --format='table(disks[].deviceName,disks[].boot,disks[].autoDelete)'\nDEVICE_NAME: boot, data-workspace\nBOOT: True, False\nAUTO_DELETE: True, True          # <- both disks go when the instance goes\n\n$ gcloud compute disks describe my-instance-data-workspace --format='value(status,users)'\nREADY   my-instance              # a stopped VM keeps its disks\n<\/script><script type=\"text/plain\" id=\"ev-b0\">\n# everything on the VM arrives by one of two routes:\n#   1. baked into the boot image (Google builds it)\n#   2. container images: mostly baked as well, one pulled at boot\n<\/script><script type=\"text/plain\" id=\"ev-b1\">\n$ gcloud compute disks describe my-instance-boot --format='value(licenses)'\n.../projects/cos-cloud/global/licenses/cos\n.../projects/click-to-deploy-images/global/licenses/c2d-dl-platform-workbench-instances-custom-container-host\n\n$ cat /etc/os-release\nPRETTY_NAME=\"Container-Optimized OS from Google\"\n$ uname -r\n6.x.y+\n<\/script><script type=\"text/plain\" id=\"ev-b2\">\n$ gcloud compute images describe workbench-container-host-BUILD_TAG --project cloud-notebooks-managed\nERROR: Required 'compute.images.get' permission for\n  'projects/cloud-notebooks-managed/global/images/workbench-container-host-BUILD_TAG'\n\n# so the image's family, description and build pipeline are not visible to you\nversion (instance metadata): BUILD_TAG         # same tag as the baked agent images\n<\/script><script type=\"text/plain\" id=\"ev-b3\">\n$ gcloud compute disks describe my-instance-boot\nsourceImage:   .../cloud-notebooks-managed/global/images/workbench-container-host-BUILD_TAG\nsourceImageId: '<numeric id>'\ntype: pd-standard\nguestOsFeatures: UEFI_COMPATIBLE, VIRTIO_SCSI_MULTIQUEUE, GVNIC, SECURE_BOOT (capable), ...\n# cos-update-strategy = update_disabled (instance metadata): the host stays on this image\n<\/script><script type=\"text/plain\" id=\"ev-b4\">\n$ ls -la /mnt/stateful_partition/workbench\ncloud-config.yaml                  <- baked (image build date)\nconfigure.sh                       <- baked\nutils.sh                           <- baked\njupyter_notebook_config.py         <- baked\nmount-disk.sh                      <- written at boot (boot date)\npull-custom-container-payload.sh   <- written at boot\nrun_post_startup_script.sh         <- written at boot\n<\/script><script type=\"text/plain\" id=\"ev-b5\">\n$ docker images --format '{{.Repository}}:{{.Tag}}'\nvertex/workbench-instances-agent:local     (+ vertex/colab-enterprise-agent:local)\nvertex/gcloud:local\nvertex/inverting-proxy-agent:local\nvertex/executor-agent:local\nvertex/opencode:local                      # optional extras, depends on the image\nus.gcr.io/cos-cloud/cos-gpu-installer:<version>\ngcr.io/cloud-builders/metadata:latest\n\n# the first units run these images before any pull happens\n# registry tags match the host image build, e.g. .../workbench-agent:BUILD_TAG\n<\/script><script type=\"text/plain\" id=\"ev-b6\">\nStarting pull-custom-container-payload.service...\ncrictl pull --creds oauth2accesstoken:<token> \\\n  REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\njupyter-payload.service starts            # typically minutes later\n\n$ nerdctl -n k8s.io ps\npayload-container  REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\n\n# documented: with the :latest tag the instance pulls a new image on every restart\n<\/script><script type=\"text/plain\" id=\"ev-b7\">\nbaked        COS, docker/containerd/runc/nerdctl/crictl, gcfsd, cloud-config.yaml, the agent images\nwritten      ~20 systemd units + helper scripts (cloud-init, from the baked cloud-config), at every boot\npulled       your Jupyter image only (crictl + gcfs, containerd namespace k8s.io)\n\nversions:    baked parts move together (one build tag); the pulled image floats with :latest\n<\/script><script type=\"text/plain\" id=\"ev-d0\">\n$ curl -s -H 'Metadata-Flavor: Google' \\\n    http://metadata.google.internal/computeMetadata/v1/instance/attributes/\ncos-update-strategy\ncustom-container-image\ncustom-container-payload\ndisable-swap-binaries\nenable-guest-attributes\nenable-oslogin\ngoogle-logging-enabled\nidle-timeout-seconds ...                     # about two dozen keys in all\n<\/script><script type=\"text/plain\" id=\"ev-d1\">\n$ curl -s -H 'Metadata-Flavor: Google' \\\n    http://metadata.google.internal/computeMetadata/v1/instance/attributes/idle-timeout-seconds\n3600\n\n# written by the Notebooks service agent at insert, and by later setMetadata calls\n# (the one key you supplied yourself: idle-timeout-seconds)\n<\/script><script type=\"text/plain\" id=\"ev-d2\">\nIdentity        notebooks-api=PROD  notebooks-api-version=v2  version=BUILD_TAG\n                resource-url=.../instances/my-instance  instance-region=REGION\nContainer       custom-container-payload=REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\n                custom-container-image=true  cos-update-strategy=update_disabled\nProxy/ingress   proxy-backend-id=BACKEND_ID  proxy-url=BACKEND_ID...notebooks.googleusercontent.com\n                proxy-registration-url=https://REGION.notebooks.cloud.google.com/tun/m/<redacted>\n                proxy-mode=service_account  new-proxy-agent-enabled=true  service-account-mode=true\nLifecycle       idle-timeout-seconds=3600  shutdown-script=<path>\nAccess/logging  enable-oslogin=TRUE  enable-guest-attributes=TRUE  google-logging-enabled=true  serial-port-logging-enable=true\nFeature flags   enable-jupyterlab4=true  enable-antigravity=true  disable-swap-binaries=true\nReporting       report-event-url=.../instances/my-instance:reportInfoSystem\nuser-data       #include file:///mnt/stateful_partition/workbench/cloud-config.yaml\n<\/script><script type=\"text/plain\" id=\"ev-d3\">\nuser-data = #include file:///mnt/stateful_partition/workbench/cloud-config.yaml\n\n$ systemd-analyze critical-chain         # typical shape\ncloud-init.service   @ ~15-20 s\ncloud-final.service  @ ~20 s + several minutes     # runcmd: /etc/systemd/system/startup.sh\n\nusers: jupyter (uid 2000), executoragent (uid 2001)   write_files: ~20 units + scripts\n<\/script><script type=\"text/plain\" id=\"ev-d4\">\n# instance metadata                        ->  /tmp/ENV_INFO   (matched by name and value)\ncustom-container-payload = REGION-docker.pkg.dev/PROJECT/REPO/YOUR_IMAGE:latest\n                                           ->  WORKBENCH_CUSTOM_CONTAINER_PAYLOAD=<same value>\ninstance-region = REGION                   ->  INSTANCE_REGION=REGION\nproxy-backend-id = BACKEND_ID              ->  BACKEND_ID=BACKEND_ID\nproxy-registration-url = https://...       ->  PROXY_REGISTRATION_URL=<same value>\n(unset)                                    ->  DOCKER_RUN_CUSTOM_PARAMS=  ENV_FILE_FLAG=  POST_STARTUP_SCRIPT_PATH=\n# the agent that does the mapping (service_generator_agent) is not publicly documented\n<\/script><script type=\"text/plain\" id=\"ev-d5\">\n# jupyter-payload.service (excerpt)\nEnvironmentFile=/tmp/ENV_INFO\nExecStart=/var/lib/google/nerdctl/nerdctl --snapshotter=gcfs -n k8s.io run --name payload-container \\\n  -p 127.0.0.1:8080:8080/tcp $RUNTIME_FLAG $GCE_METADATA_FLAG $DOCKER_RUN_CUSTOM_PARAMS $ENV_FILE_FLAG \\\n  $ALLOW_FUSE_FLAG --user $CONTAINER_USER ... \\\n  -e \"GOOGLE_CLOUD_PROJECT=${PROJECT_ID}\" -e \"GOOGLE_CLOUD_REGION=${INSTANCE_REGION}\" \\\n  \"${WORKBENCH_CUSTOM_CONTAINER_PAYLOAD}\"\n\n# from inside payload-container, the metadata server also answers directly:\n$ curl -s -H 'Metadata-Flavor: Google' http://metadata.google.internal/.../attributes/idle-timeout-seconds\nHTTP 200\n<\/script><script type=\"text/plain\" id=\"ev-d6\">\n# proxy-agent (docker run, --net host)\n--env BACKEND=BACKEND_ID   --env PROXY=$PROXY_REGISTRATION_URL/   --env HOSTNAME=127.0.0.1   --env PORT=8080\n\n# an optional extra may read the key directly from the metadata server:\nBACKEND_ID=$(curl -s -H 'Metadata-Flavor: Google' \\\n  http://metadata.google.internal/computeMetadata/v1/instance/attributes/proxy-backend-id)\n# e.g. to build a CORS origin:  https://${BACKEND_ID}.notebooks.googleusercontent.com\n<\/script><script type=\"text/plain\" id=\"ev-d7\">\nhealth-agent log:\nReporting url: https://notebooks.googleapis.com/v2/projects/my-project/locations/ZONE/\n  instances/my-instance:reportInfoSystem        # = the report-event-url value\nResponse: <Response [200]>\n\n$ id        uid=NNNNNNNNNN(user_example_com)               # enable-oslogin=TRUE\n$ ls <shutdown-script path>\nls: cannot access ...: No such file or directory           # may not exist on a COS host\n$ free -h   Swap: 0B                                       # disable-swap-binaries=true\n<\/script><script type=\"text/plain\" id=\"ev-d8\">\n$ curl -s -H 'Metadata-Flavor: Google' \\\n    'http://metadata.google.internal/computeMetadata/v1/instance/guest-attributes/?recursive=true'\nguest-agent/\nhostkeys/\nnotebooks/\nworkbench-notebooks/\n\n# enable-guest-attributes=TRUE; documented: idle shutdown requires it\n<\/script><script type=\"text/plain\" id=\"ev-d9\">\n$ gcloud workbench instances update my-instance --project my-project --location ZONE \\\n    --metadata=container-env-file=FOO=bar,post-startup-script=gs://BUCKET/x.sh,post-startup-script-behavior=run_every_start\n# Compute then records another setMetadata by the service agent\n\n# documented: a new idle-timeout-seconds applies to a running instance without a restart\n# inferred:   container-* and post-startup keys are picked up when workbench-configure next runs, at boot\n<\/script><script type=\"text/plain\" id=\"ev-e0\">\n$ lsblk -o NAME,SIZE,TYPE,MOUNTPOINT\nsda   (boot size) disk\nsdb   (data size) disk /home/jupyter\n<\/script><script type=\"text/plain\" id=\"ev-e1\">\n$ gcloud compute instances describe my-instance --format='table(disks[].deviceName,disks[].interface,disks[].mode,disks[].autoDelete)'\nDEVICE_NAME: boot, data-workspace   INTERFACE: SCSI, SCSI   MODE: READ_WRITE, READ_WRITE\nAUTO_DELETE: True, True\n<\/script><script type=\"text/plain\" id=\"ev-e2\">\n$ lsblk -o NAME,SIZE,TYPE,MOUNTPOINT\nsda        (boot size) disk\n|-sda1     (most)      part /mnt/stateful_partition\n|-sda2      32M part\n|-sda3       2G part\n| `-vroot  ~2G  dm   /\n|-sda4      32M part\n|-sda5       2G part\n|-sda6/7   512B part\n|-sda8      16M part /usr/share/oem\n|-sda9/10  512B part\n|-sda11      8M part\n`-sda12     64M part\n$ cat /proc/cmdline\nBOOT_IMAGE=/syslinux/vmlinuz.A init=/usr/lib/systemd/systemd rootwait ro ...\n<\/script><script type=\"text/plain\" id=\"ev-e3\">\n$ df -h /\n/dev/root       2.0G  ...   ...  mostly full /\n$ lsblk\n`-vroot ~2G dm /                       # device-mapper verity target, mounted read-only\n$ findmnt /usr/share/oem               # from sda8\n<\/script><script type=\"text/plain\" id=\"ev-e4\">\n$ df -h /var\n/dev/sda1       (most of the boot disk)  /var\n$ lsblk | grep stateful\nsda1  part /mnt/stateful_partition\n\n# what lives there:\n/mnt/stateful_partition/workbench/        cloud-config.yaml, scripts\n/var/lib/docker, /var/lib/containerd      images, snapshots, gcfs layer cache\n<\/script><script type=\"text/plain\" id=\"ev-e5\">\n# mount-disk.sh\nmount_data_disk            # /dev/disk/by-id/google-data-workspace -> /home/jupyter\nsudo mount -o remount,exec \"/home/${JUPYTER_USER}\"\nsudo chown -R \"${CONTAINER_USER}\" \"/home/${JUPYTER_USER}\"      # if the owner differs (0:0)\n\n$ findmnt /home/jupyter\n/home/jupyter  /dev/sdb  ext4  rw,relatime,discard\n$ df -h /home/jupyter\n/dev/sdb        (data size)  ~empty on first boot\n<\/script><script type=\"text/plain\" id=\"ev-e6\">\n$ nerdctl -n k8s.io exec payload-container sh -c 'df -h /home/jupyter /'\n/dev/sdb        <data disk>   /home/jupyter\noverlay         <boot disk>   /\n$ docker inspect <extra container> --format '{{json .HostConfig.Binds}}'\n[\"/home/jupyter:/home/jupyter\"]\n<\/script><script type=\"text/plain\" id=\"ev-e7\">\nsurvives stop/start   /home/jupyter (sdb), stateful partition (images, scripts, gcfs cache)\nrecreated each start  container writable layers, /tmp/ENV_INFO, units written by cloud-init\ndeleted with VM       both disks (autoDelete: true)  <- including /home/jupyter\nwhile stopped         disks READY, still billed; compute billing stops\n<\/script><script type=\"text/plain\" id=\"ev-f0\">\n$ gcloud compute networks describe default\nname: default      autoCreateSubnetworks: true      routingMode: REGIONAL\n<\/script><script type=\"text/plain\" id=\"ev-f1\">\n$ gcloud compute networks subnets describe default --region REGION\nipCidrRange: 10.x.0.0/20   gatewayAddress: 10.x.0.1   privateIpGoogleAccess: true   stackType: IPV4_ONLY\n$ gcloud compute routes list\ndefault-route-...  0.0.0.0/0  default-internet-gateway  priority 1000\n$ gcloud compute routers list\n(none, unless you created Cloud NAT)\n<\/script><script type=\"text/plain\" id=\"ev-f2\">\n$ gcloud compute instances describe my-instance --format='yaml(networkInterfaces)'\nnic0: network default, subnetwork default, networkIP 10.x.x.x, stackType IPV4_ONLY\naccessConfigs: external-nat, type ONE_TO_ONE_NAT, networkTier PREMIUM      # natIP only while running\n$ ip -br addr\neth0     UP    10.x.x.x/32\ndocker0  DOWN  172.17.0.1/16\nnerdctl0 UP    10.4.0.1/24\n<\/script><script type=\"text/plain\" id=\"ev-f3\">\n$ gcloud compute firewall-rules list     # a default network, ingress\ndefault-allow-ssh        tcp:22                 0.0.0.0/0\ndefault-allow-rdp        tcp:3389               0.0.0.0/0\ndefault-allow-icmp       icmp                   0.0.0.0/0\ndefault-allow-internal   tcp/udp/icmp all       10.128.0.0/9\n(+ any rules your project has added)\n\n$ ss -ltnp          # what actually listens\n0.0.0.0:22 sshd    127.0.0.1:8080 (Jupyter, via port-forward)    # plus any optional extras\n<\/script><script type=\"text/plain\" id=\"ev-f4\">\n$ ip -br addr\nlo        127.0.0.1/8\neth0      10.x.x.x/32\ndocker0   172.17.0.1/16   DOWN\nnerdctl0  10.4.0.1/24     UP     (veth to the container)\n\n$ readlink /proc/<jupyter pid>/ns/net  vs  /proc/1/ns/net     # different: its own network namespace\npayload-container: eth0 10.4.0.x/24\n\n# agents: docker run --net host ...    (share eth0 and lo)\n<\/script><script type=\"text/plain\" id=\"ev-f5\">\nhttps://BACKEND_ID-dot-REGION.notebooks.googleusercontent.com    # 1\n\nproxy-agent log:                                                  # 2, 3\nRequest forwarding timeout is 1h0m0s; proxy timeout is 1m0s\nWebsocket connection to the server \"ws://127.0.0.1:8080/api/events/subscribe\" established for session: 1\n\n$ iptables -t nat -S | grep CNI-HOSTPORT-DNAT                     # 4\n# 127.0.0.1:8080 on the host -> <container IP>:8080               # 5\n$ curl -s http://127.0.0.1:8080/api\n{\"version\": \"2.x.y\"}\n<\/script><script type=\"text/plain\" id=\"ev-f6\">\nhealth-agent log (every ~30 s):\nReporting url: https://notebooks.googleapis.com/v2/projects/my-project/locations/ZONE/instances/my-instance:reportInfoSystem\nResponse: <Response [200]>\n\npull: crictl pull REGION-docker.pkg.dev/PROJECT/REPO/...                   # Artifact Registry\nfrom inside payload-container: curl http://metadata.google.internal/...    # HTTP 200 (via the bridge + NAT)\n<\/script><script type=\"text/plain\" id=\"ev-f7\">\n$ gcloud compute ssh my-instance --tunnel-through-iap\n$ who\nuser_example_com pts/0 ... (35.235.2xx.xx)             # inside IAP's 35.235.240.0/20\n\n$ id\nuid=NNNNNNNNNN(user_example_com)                        # OS Login (enable-oslogin=TRUE)\n# default-allow-ssh also admits tcp:22 from 0.0.0.0/0, so IAP is optional\n<\/script><script type=\"text/plain\" id=\"ev-f8\">\n$ sudo ss -ltnp | grep -v 127.0.0\n0.0.0.0:22          sshd\n0.0.0.0:<high port> <optional extra service>      # does it have authentication?\n\n# who can reach a listener on 0.0.0.0:\n#   the internet            only if a firewall rule allows that port\n#   VMs in the same VPC     often yes (default-allow-internal)\n#   same-service-account VMs  if a rule targets that service account\n\n# mitigations: set a password/token, stop the unit, or add a deny rule\n<\/script><script type=\"text/plain\" id=\"ev-s13b\">\n#!/bin/bash\n# post-startup.sh   (SAMPLE: illustrative, untested)\n#\n# Runs on the COS HOST as root, after payload-container is up.\n# Mounts a GCS bucket with gcsfuse INSIDE the container and rsyncs\n# /home/jupyter into it every 5 minutes.\n#\n# Use with post-startup-script-behavior=run_every_start: the container is\n# recreated on every start, so the mount and the sync loop must be too.\n\nBUCKET=\"my-workbench-backup\"          # <-- your bucket\nDEST=\"my-instance/home-jupyter\"     # folder inside the bucket\nC=\"payload-container\"\nNCTL=\"/var/lib/google/nerdctl/nerdctl -n k8s.io\"\n\n# 1. wait until the Jupyter container is running (about 2 minutes at most)\nfor i in $(seq 1 60); do\n  [ \"$($NCTL inspect -f '{{.State.Running}}' $C 2>/dev/null)\" = \"true\" ] && break\n  sleep 2\ndone\n\n# 2. fail early, with a clear message, if the tools are not in the image\nif ! $NCTL exec $C sh -c 'command -v gcsfuse >/dev/null && command -v rsync >/dev/null'; then\n  echo \"gcsfuse or rsync missing in $C. Alternative: gcloud storage rsync -r /home/jupyter gs://$BUCKET/$DEST\" >&2\n  exit 1\nfi\n\n# 3. mount the bucket at /mnt/gcs: inside the container, and NOT under\n#    /home/jupyter, so rsync never copies the mount into itself\n$NCTL exec $C bash -c \"mkdir -p /mnt/gcs && (mountpoint -q /mnt/gcs || gcsfuse --implicit-dirs $BUCKET /mnt/gcs)\"\n\n# 4. start a detached sync loop (flock keeps it to a single copy)\n$NCTL exec -d $C bash -c \"\n  exec 9>/tmp/gcs-sync.lock; flock -n 9 || exit 0\n  while true; do\n    rsync -r --inplace --size-only --no-perms --no-owner --no-group \\\n          --exclude='.cache/' --exclude='.container_gcloud/' \\\n          /home/jupyter/ /mnt/gcs/$DEST/\n    sleep 300\n  done\n\"\n\n<\/script><script>\n(() => {\n'use strict';\nconst NS = 'http://www.w3.org/2000/svg';\nconst $ = (s, r = document) => r.querySelector(s);\nconst ev = id => { const e = document.getElementById('ev-' + id); return e ? e.textContent.replace(/^\\n/, '') : ''; };\n\n/* ---------------- theme ---------------- */\nconst root = document.documentElement;\ntry { const t = localStorage.getItem('wb-theme'); if (t) root.setAttribute('data-theme', t); } catch (e) {}\n$('#theme').addEventListener('click', () => {\n  const dark = getComputedStyle(root).colorScheme.indexOf('dark') >= 0 && root.getAttribute('data-theme') !== 'light';\n  const next = dark ? 'light' : 'dark';\n  root.setAttribute('data-theme', next);\n  try { localStorage.setItem('wb-theme', next); } catch (e) {}\n});\n\n/* ---------------- copy buttons ---------------- */\ndocument.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', () => {\n  const el = document.getElementById(b.dataset.copy);\n  const txt = el ? el.textContent : '';\n  const done = () => { const o = b.textContent; b.textContent = 'Copied'; setTimeout(() => b.textContent = o, 1200); };\n  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(done, () => {});\n  else { const ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (e) {} ta.remove(); }\n}));\n\n/* ---------------- metadata filter ---------------- */\nconst mf = document.getElementById('mfilter');\nif (mf) mf.addEventListener('input', () => {\n  const q = mf.value.trim().toLowerCase();\n  document.querySelectorAll('#metaall tbody tr').forEach(tr => { tr.hidden = !!q && tr.textContent.toLowerCase().indexOf(q) < 0; });\n});\n\n/* ================= boot scene data ================= */\nconst NODES = [\n  {id:'user',     x:20,  y:30,  w:190, h:56,  k:'ext',    t:'You (terminal)',        s:['gcloud CLI']},\n  {id:'api',      x:20,  y:130, w:190, h:64,  k:'cloud',  t:'Notebooks API',         s:['notebooks.googleapis.com/v2']},\n  {id:'registry', x:20,  y:286, w:190, h:64,  k:'cloud',  t:'Artifact Registry',     s:['REGION-docker.pkg.dev','/PROJECT/REPO']},\n  {id:'browser',  x:20,  y:380, w:190, h:56,  k:'ext',    t:'You (browser)',         s:['signed in to Google']},\n  {id:'proxy',    x:20,  y:470, w:190, h:74,  k:'cloud',  t:'Google inverting proxy',s:['BACKEND_ID-dot-REGION','.notebooks.googleusercontent\u2026']},\n  {id:'mdsrv',    x:1110,y:40,  w:180, h:64,  k:'meta',   t:'GCE metadata server',   s:['169.254.169.254']},\n  {id:'bucket',   x:1110,y:400, w:180, h:64,  k:'sample', t:'Cloud Storage bucket',  s:['gs://my-workbench-backup','(sample)']},\n  {id:'state',    x:1110,y:640, w:180, h:56,  k:'state',  t:'Instance state',        s:['']},\n\n  {id:'bootdisk', x:250, y:50,  w:190, h:74,  k:'disk',   t:'Boot disk',             s:['COS \u00b7 / is dm-verity (ro)','sda1 \u2192 /mnt/stateful_partition']},\n  {id:'kernel',   x:462, y:50,  w:150, h:56,  k:'vm',     t:'Linux kernel',          s:['+ system