56, w:150, h:60,  k:'agent',  t:'idle-shutdown',         s:['agent \u00b7 polls Jupyter']},\n  {id:'diag',     x:736, y:556, w:150, h:60,  k:'agent',  t:'diagnostic-service',    s:['privileged \u00b7 --pid host']},\n  {id:'opencode', x:898, y:556, w:162, h:60,  k:'agent',  t:'optional extras',       s:['e.g. an AI agent UI']},\n  {id:'post',     x:700, y:640, w:340, h:56,  k:'svc',    t:'run-post-startup.service', s:['']},\n];\nconst FRAMES = [\n  {id:'vm',  x:230, y:16, w:850, h:692, label:'The VM \u00b7 a standard machine type \u00b7 one zone', lx:246, ly:12},\n];\nconst LABELS = [\n  {id:'lblagents', x:700, y:548, text:'Docker containers \u00b7 host network \u00b7 namespace moby'},\n];\n// pts = polyline; both = arrow at both ends; lbl at [x,y]\nconst EDGES = [\n  {id:'user_api',  pts:[[115,86],[115,130]], lbl:'create', l:[122,112]},\n  {id:'api_vm',    pts:[[210,162],[222,162],[222,87],[250,87]]},\n  {id:'boot_kernel',pts:[[440,80],[462,80]]},\n  {id:'kernel_init',pts:[[612,78],[634,78]]},\n  {id:'init_startup',pts:[[824,78],[846,78]]},\n  {id:'md_init',   pts:[[1110,56],[1096,56],[1096,32],[729,32],[729,50]], lbl:'user-data', l:[910,28]},\n  {id:'md_cfg',    pts:[[1110,88],[1090,88],[1090,132],[547,132],[547,150]], lbl:'instance attributes', l:[800,128]},\n  {id:'startup_cfg',pts:[[900,106],[900,118],[500,118],[500,150]], lbl:'step 2', l:[700,114]},\n  {id:'cfg_env',   pts:[[632,180],[654,180]]},\n  {id:'docker_cd', pts:[[345,210],[345,267],[462,267]]},\n  {id:'gcfs_cd',   pts:[[943,210],[943,240]], lbl:'gcfs', l:[950,230]},\n  {id:'reg_pull',  pts:[[210,318],[462,354]], lbl:'crictl pull', l:[330,328]},\n  {id:'pull_cd',   pts:[[547,324],[547,294]]},\n  {id:'cd_payload',pts:[[850,294],[850,324]], lbl:'nerdctl run \u2192 runc', l:[858,314]},\n  {id:'lo_payload',pts:[[632,442],[654,442]]},\n  {id:'mount',     pts:[[345,478],[345,530],[850,530],[850,520]], lbl:'bind mount', l:[560,526]},\n  {id:'pa_proxy',  pts:[[325,556],[325,512],[210,512]], lbl:'outbound tunnel', l:[268,506], both:true},\n  {id:'pa_lo',     pts:[[375,556],[375,498],[490,498],[490,470]]},\n  {id:'ha_lo',     pts:[[487,556],[487,510],[547,510],[547,470]]},\n  {id:'ia_lo',     pts:[[649,556],[649,510],[604,510],[604,470]]},\n  {id:'ha_api',    pts:[[487,616],[487,714],[8,714],[8,162],[20,162]], lbl:'HEALTH every ~30 s', l:[240,710]},\n  {id:'browser_proxy',pts:[[115,436],[115,470]], lbl:'open URL', l:[122,456]},\n  {id:'rtread',    pts:[[1060,350],[1200,350],[1200,104]], lbl:'live read: attributes + SA token', l:[1128,344], both:true},\n  {id:'post_gcs',  pts:[[1040,668],[1071,668],[1071,490],[1044,490]], lbl:'nerdctl exec', l:[1076,600], sample:true},\n  {id:'fuse_bucket',pts:[[1044,462],[1062,462],[1062,432],[1110,432]], lbl:'to GCS', l:[1066,426], sample:true},\n];\n\n/* ---------------- steps ---------------- */\n// r.n / r.e: nodes and edges revealed from this step on. f: nodes in focus. fl: edges animated. set: text overrides.\nconst STEPS = [\n {key:'s0', tl:-1, time:'t = 0', title:'Clean slate',\n  r:{n:['user'], e:[], fr:[]}, f:['user'], set:{state:null},\n  what:['Nothing exists yet: no VM, no disks, no containers, no agents.','One command asks the Notebooks API for a container-based Workbench instance. The image to run is passed as <code>--container-repository<\/code> and <code>--container-tag<\/code>.','The rest of this walkthrough is what that command typically causes, in the order it happens.'],\n  ev:'s0', evt:'your terminal'},\n {key:'s1', tl:0, time:'creation', title:'The Notebooks API creates the VM',\n  r:{n:['api','bootdisk','datadisk','mdsrv'], e:['user_api','api_vm'], fr:['vm']}, f:['api','bootdisk','datadisk'], set:{state:['PROVISIONING']},\n  what:['The API creates a Compute Engine VM with <b>two disks<\/b>: a boot disk cloned from a Google-owned image, and a blank data disk named <code>data-workspace<\/code>.','The boot image is named like <code>workbench-container-host-BUILD_TAG<\/code> and lives in the project <code>cloud-notebooks-managed<\/code>. Its licences show Container-Optimized OS.','The API also writes <b>instance metadata<\/b>, including <code>custom-container-payload<\/code> (the image you chose) and a <code>user-data<\/code> key that points at a cloud-config file on the disk.'],\n  note:'<span class=\"tag obs\">typical<\/span>You cannot read the image in <code>cloud-notebooks-managed<\/code> (<code>compute.images.get<\/code> is denied), so its family and description are not visible to you.',\n  ev:'s1', evt:'gcloud compute disks describe'},\n {key:'s2', tl:1, time:'first seconds', title:'Kernel and systemd boot Container-Optimized OS',\n  r:{n:['kernel'], e:['boot_kernel'], fr:[]}, f:['kernel','bootdisk'],\n  what:['The kernel boots in a few seconds. The root filesystem is a <b>small dm-verity device, read-only<\/b>.','COS has no package manager. Anything extra runs in containers, and persistent state lives on the stateful partition (<code>sda1<\/code>) and the data disk.','<code>docker.socket<\/code> and containerd come up early, because everything that follows is container-based.'],\n  ev:'s2', evt:'systemd-analyze'},\n {key:'s3', tl:2, time:'tens of seconds in', title:'cloud-init reads the user-data',\n  r:{n:['cloudinit'], e:['kernel_init','md_init'], fr:[]}, f:['cloudinit','mdsrv'],\n  what:['cloud-init asks the metadata server for <code>user-data<\/code>, which is <code>#include file:///mnt/stateful_partition/workbench/cloud-config.yaml<\/code>.','From that file it <b>creates two users<\/b> (<code>jupyter<\/code> and <code>executoragent<\/code>), and <b>writes about 20 systemd units<\/b> plus helper scripts to <code>/etc/systemd/system<\/code> and <code>/mnt/stateful_partition/workbench<\/code>.','The last instruction is <code>runcmd: /etc/systemd/system/startup.sh<\/code>.'],\n  ev:'s3', evt:'cloud-init'},\n {key:'s4', tl:2, time:'cloud-final', title:'startup.sh takes over: about a dozen steps, one after another',\n  r:{n:['startup'], e:['init_startup'], fr:[]}, f:['startup'],\n  what:['<code>cloud-final.service<\/code> runs <code>startup.sh<\/code> <b>synchronously<\/b>. It is a list of <code>systemctl start<\/code> commands, so the boot is mostly <b>sequential<\/b>.','That one service accounts for nearly all of the boot time, which is why userspace boot takes several minutes.','Steps: configure, mount the data disk, start image streaming, pull the image, start Jupyter, start the agents, start any extras, run the post-startup script, clean up.'],\n  ev:'s4', evt:'startup.sh'},\n {key:'s5', tl:3, time:'step 2 \u00b7 seconds', title:'workbench-configure turns metadata into /tmp/ENV_INFO',\n  r:{n:['docker','configure','envinfo'], e:['md_cfg','startup_cfg','cfg_env'], fr:[]}, f:['configure','envinfo'], fl:['md_cfg','cfg_env'],\n  what:['<code>workbench-configure.service<\/code> runs a <b>Docker container<\/b> (<code>workbench-instances-agent<\/code>, command <code>service_generator_agent<\/code>) with <code>/etc<\/code>, <code>/tmp<\/code> and the systemd directory bind-mounted.','The agent reads instance metadata and writes <b><code>/tmp/ENV_INFO<\/code><\/b>, a flat <code>KEY=VALUE<\/code> file, and (inferred) generated unit files.','Later units load it with <code>EnvironmentFile=/tmp/ENV_INFO<\/code> and expand it into command lines. This is how metadata cascades down to the Jupyter container.'],\n  note:'<span class=\"tag inf\">inferred<\/span>The mapping from metadata key to variable is inside a binary that is not publicly documented. The variable names below are what such a file typically contains.',\n  ev:'s5', evt:'/tmp/ENV_INFO'},\n {key:'s6', tl:3, time:'step 2 \u00b7 seconds', title:'The data disk is mounted at /home/jupyter',\n  r:{n:[], e:[], fr:[]}, f:['datadisk'], set:{datadisk:['ext4 \u2192 /home/jupyter \u2713']},\n  what:['<code>workbench-mount-disk.service<\/code> finds <code>/dev/disk/by-id/google-data-workspace<\/code> (device <code>sdb<\/code>) and mounts it at <b><code>/home/jupyter<\/code><\/b>, then remounts it with <code>exec<\/code>.','If the directory is not owned by the container user, it runs <code>chown -R 0:0<\/code> on it, because the container runs as root.','This disk <b>persists across restarts<\/b>. It is later bind-mounted into the Jupyter container (and into any extras).'],\n  ev:'s6', evt:'mount-disk.sh'},\n {key:'s7', tl:3, time:'step 3 \u00b7 seconds', title:'Image streaming: gcfsd, the snapshotter and containerd',\n  r:{n:['gcfs','containerd'], e:['gcfs_cd','docker_cd'], fr:[]}, f:['gcfs','containerd'], fl:['gcfs_cd'],\n  what:['<code>riptide-init<\/code> has copied the streaming config into place. <b><code>gcfsd<\/code><\/b> mounts a FUSE filesystem at <code>/run/gcfsd/mnt<\/code>, and a <b>snapshotter plugin<\/b> (<code>containerd-gcfs-grpc<\/code>) is registered with containerd as <code>gcfs<\/code>.','containerd is then restarted so it picks that up. It is the single container manager: Docker, nerdctl and crictl all talk to it, and it launches <b>runc<\/b> to create each container.','The idea: file contents are fetched from the registry on first read, so a container can start before the whole image has downloaded.'],\n  note:'<span class=\"tag obs\">typical<\/span>The config and mount look like this. The lazy-fetch behaviour is Google\\'s documented design for image streaming.',\n  ev:'s7', evt:'containerd + gcfsd'},\n {key:'s8', tl:4, time:'step 4 \u00b7 minutes', title:'The Jupyter image is pulled: the slow step',\n  r:{n:['registry','pull'], e:['reg_pull','pull_cd'], fr:[]}, f:['pull','registry'], fl:['reg_pull','pull_cd'], bar:true,\n  what:['The script gets a token with <code>gcloud auth print-access-token<\/code> inside a throw-away <code>vertex/gcloud<\/code> container, then runs <b><code>crictl pull<\/code><\/b> through the gcfs snapshotter.','On <b>first boot only<\/b>, if <code>/home/jupyter<\/code> is empty, it also copies the image\\'s <code>/home<\/code> content onto the data disk, which forces those files to download.','This unit typically takes <b>several minutes<\/b> and dominates the boot. The time depends on the image size, the region and the registry.'],\n  note:'<span class=\"tag inf\">inferred<\/span>Part of the time may be the first-boot copy reading files from the streamed image. The journal has no per-step timings.',\n  ev:'s8', evt:'pull-custom-container-payload'},\n {key:'s9', tl:5, time:'step 6 \u00b7 seconds', title:'nerdctl starts payload-container (this is Jupyter)',\n  r:{n:['payload','lo','home'], e:['cd_payload','lo_payload','mount'], fr:[]}, f:['payload','home'], fl:['cd_payload','mount'],\n  what:['<code>jupyter-payload.service<\/code> expands <code>ENV_INFO<\/code> into one <code>nerdctl run<\/code> command in containerd namespace <b><code>k8s.io<\/code><\/b>. containerd starts a shim, and the shim runs <b>runc<\/b>, which creates the namespaces and cgroups.','Key flags: publish <b><code>127.0.0.1:8080<\/code><\/b> only, FUSE enabled (<code>--device /dev/fuse --cap-add SYS_ADMIN<\/code>), <code>--user 0:0<\/code>, <code>/home/jupyter<\/code> bind-mounted, and environment such as <code>GOOGLE_CLOUD_PROJECT<\/code> and <code>VERTEX_PRODUCT<\/code>.','Inside, PID 1 is <code>/run_jupyter.sh<\/code>, which starts <b><code>jupyter-lab --allow-root<\/code><\/b> on <code>0.0.0.0:8080<\/code> with an empty token. The container gets its own mnt, pid, net, uts, ipc and cgroup namespaces.'],\n  ev:'s9', evt:'payload-container'},\n {key:'s10', tl:5, time:'step 8 \u00b7 seconds', title:'proxy-agent opens an outbound tunnel to Google',\n  r:{n:['proxyagent','proxy','browser','lblagents'], e:['pa_proxy','pa_lo'], fr:[]}, f:['proxyagent','proxy'], fl:['pa_proxy','pa_lo'],\n  what:['<code>proxy-agent<\/code> is a Docker container on the <b>host network<\/b>. It registers with Google\\'s inverting proxy using the <code>BACKEND<\/code> id and registration URL from <code>ENV_INFO<\/code>, and keeps an <b>outbound<\/b> connection open.','So the VM needs <b>no inbound port<\/b> for Jupyter. Requests arrive down this tunnel and are forwarded to <code>127.0.0.1:8080<\/code>.','On the host, <code>127.0.0.1:8080<\/code> is a CNI port-forward (iptables DNAT) into the container on the <code>nerdctl0<\/code> bridge.'],\n  ev:'s10', evt:'proxy-agent'},\n {key:'s11', tl:5, time:'step 8 \u00b7 seconds', title:'Health, idle-shutdown and diagnostic agents start',\n  r:{n:['healthagent','idleagent','diag','lblagents'], e:['ha_lo','ia_lo','ha_api'], fr:[]}, f:['healthagent','idleagent','diag'], fl:['ha_api'],\n  what:['All three run from one image, with <code>--net host<\/code>, so they reach Jupyter at <code>127.0.0.1:8080<\/code>.','<b>health-agent<\/b> posts a HEALTH report to the Notebooks API about every 30 s. It watches the agent containers by name and has the Docker socket mounted.','<b>idle-shutdown-agent<\/b> polls Jupyter for activity against <code>idle-timeout-seconds<\/code>. <b>diagnostic-service<\/b> is privileged with <code>--pid host<\/code>.'],\n  ev:'s11', evt:'agents'},\n {key:'s12', tl:5, time:'step 9 \u00b7 seconds', title:'Optional extras may start too',\n  r:{n:['opencode'], e:[], fr:[]}, f:['opencode'],\n  what:['Depending on the image version, the image\\'s own cloud-config can also start extra services, for example an AI coding agent with a web UI on a high host port, listening on all interfaces.','Such a service is not part of Jupyter. Whether it needs a password, and who can reach it, depends on the image and on your firewall.','Check with <code>ss -ltnp<\/code> on the host and secure or stop anything you do not need.'],\n  note:'<span class=\"tag warn\">check<\/span>Not something you configured, and not necessarily reachable from outside, but worth reviewing. See the Risks section.',\n  warn:true, ev:'s12', evt:'optional extras'},\n {key:'s13', tl:5, time:'steps 10 and 11', title:'run-post-startup and cleanup',\n  r:{n:['post'], e:[], fr:[]}, f:['post','startup'], set:{post:['no script set \u2192 no-op (RUN_POST_STARTUP_SCRIPT=False)']},\n  what:['<code>run-post-startup.service<\/code> is the hook for your post-startup script. It runs <b>on the COS host, as root<\/b>, after the container and agents are up.','With no script set it does nothing. <code>workbench-cleanup<\/code> then prunes unused Docker volumes and nerdctl images.','Because the script runs on the host (no package manager), it has to reach the container with <code>nerdctl -n k8s.io exec<\/code>, or work through <code>/home/jupyter<\/code>.'],\n  ev:'s13', evt:'run_post_startup_script.sh'},\n {key:'s13b', sample:true, tl:5, time:'sample \u00b7 step 10', title:'Sample: a post-startup script mounts a bucket with gcsfuse and syncs',\n  r:{n:['gcsfuse','bucket'], e:['post_gcs','fuse_bucket'], fr:[]}, f:['post','gcsfuse','bucket'], fl:['post_gcs','fuse_bucket'],\n  set:{post:['post-startup.sh from gs://\u2026 (sample)']},\n  what:['Imagine <code>post-startup-script=gs://\u2026/post-startup.sh<\/code> with <code>run_every_start<\/code>. The host runs it as root once the container is up.','It uses <code>nerdctl exec<\/code> to <b>mount the bucket with gcsfuse at <code>/mnt/gcs<\/code> inside the container<\/b> (FUSE is already enabled), then starts a detached <b>rsync loop<\/b> copying <code>/home/jupyter<\/code> into the bucket every 5 minutes.','<code>run_every_start<\/code> is needed because the container is recreated on every start, which discards the mount and the loop. The VM service account needs write access to the bucket.'],\n  note:'<span class=\"tag smp\">sample<\/span>Illustrative and <b>untested<\/b>. Whether <code>gcsfuse<\/code> and <code>rsync<\/code> exist in your image is unverified. The full script is in the Post-startup section.',\n  ev:'s13b', evt:'post-startup.sh (sample)'},\n {key:'s14', tl:6, time:'about 10 minutes', title:'The VM is ready: PROVISIONING becomes ACTIVE',\n  r:{n:['state'], e:[], fr:[]}, f:['healthagent','state','api'], fl:['ha_api'], set:{state:['ACTIVE']},\n  what:['<code>startup.sh<\/code> returns, <code>cloud-final<\/code> finishes, and <code>multi-user.target<\/code> is reached.','The health agent\\'s reports reach the Notebooks API, and the instance state changes to <b>ACTIVE<\/b>.','Roughly ten minutes from one command, most of it one image pull. A small image or a warm cache can make it much shorter.'],\n  ev:'s14', evt:'health report'},\n {key:'s15', tl:6, time:'first session', title:'You open JupyterLab: the request path',\n  r:{n:[], e:['browser_proxy','rtread'], fr:[]}, f:['browser','proxy','proxyagent','lo','payload'], fl:['browser_proxy','pa_proxy','pa_lo','lo_payload','rtread'], seq:true,\n  what:['1. The browser opens the proxy URL. Google checks your IAM access.','2. The proxy sends the request <b>down the agent\\'s outbound tunnel<\/b>. 3. <code>proxy-agent<\/code> forwards it to <code>127.0.0.1:8080<\/code> (websockets included). 4. The CNI port-forward delivers it to the container, where <code>jupyter-lab<\/code> answers.','From inside, the container can also read the metadata server (purple arrow): any attribute, and a token for the VM service account.'],\n  ev:'s15', evt:'request path'},\n {key:'s16', tl:6, time:'later \u00b7 idle stop', title:'Steady state, then the VM may stop itself',\n  r:{n:[], e:[], fr:[]}, f:['idleagent','healthagent'], fl:['ha_api'], set:{state:['STOPPED']},\n  what:['In steady state the health agent keeps reporting about every 30 s, and the idle agent watches for activity against the idle timeout (default 3 hours).','When the timeout passes, the Compute <code>stop<\/code> call is made by the <b>Notebooks service agent<\/b>, not by a user. On stop, <code>ExecStopPost<\/code> runs the shutdown script, which cleans up leftover gcsfuse mounts.','Stopped VMs stop billing for compute, but the disks still cost money until the instance is deleted.'],\n  note:'<span class=\"tag inf\">inferred<\/span>That a service-agent stop is the idle timeout: it is the usual cause, but only the idle agent\\'s logs can confirm it.',\n  ev:'s16', evt:'gcloud compute instances describe'},\n];\n\nconst SEGS = [\n  {t:'Create', d:'API call'}, {t:'Kernel', d:'seconds'}, {t:'cloud-init', d:'tens of s'}, {t:'Configure + mount', d:'seconds'},\n  {t:'Image pull', d:'minutes', c:'pull'}, {t:'Container + agents', d:'under a minute'}, {t:'Ready', d:'about 10 min total'}\n];\n\n\n/* ================= helpers ================= */\nconst N = (id, x, y, w, h, k, t, s) => ({id, x, y, w, h, k, t, s: s || []});\nconst E = (id, pts, lbl, l, o) => Object.assign({id, pts}, lbl ? {lbl, l} : {}, o || {});\nconst ST = (key, time, title, r, f, what, ev, evt, o) => Object.assign({key, tl: -1, time, title, r, f, what, ev, evt}, o || {});\n\n/* ================= scene 1: build the VM ================= */\nconst SC_BUILD = {\n  id: 'build', tab: '1 \u00b7 Build the VM', intro: 'Notebooks API \u2192 Compute API',\n  nodes: [\n    N('user', 20, 40, 190, 64, 'ext', 'You (terminal)', ['gcloud workbench', 'instances create']),\n    N('nb', 250, 40, 230, 84, 'cloud', 'Notebooks API', ['notebooks.googleapis.com/v2', 'Vertex AI Workbench control plane']),\n    N('sa', 520, 40, 260, 84, 'meta', 'Notebooks service agent', ['service-PROJECT_NUMBER@', 'gcp-sa-notebooks.iam.gserviceaccount.com']),\n    N('lro', 250, 190, 230, 64, 'cloud', 'Long-running operation', ['operation-\u2026', 'gcloud polls until done']),\n    N('compute', 520, 190, 260, 84, 'cloud', 'Compute Engine API', ['compute.googleapis.com', 'instances.insert \u00b7 setMetadata \u00b7 stop']),\n    N('image', 250, 330, 230, 92, 'cloud', 'Boot image (Google project)', ['cloud-notebooks-managed', 'workbench-container-host-', 'BUILD_TAG']),\n    N('opslog', 250, 450, 530, 150, 'ext', 'Compute operations log (typical)', ['insert        my-instance', 'setMetadata   my-instance', 'stop          my-instance', 'principal on all of them:', 'service-PROJECT_NUMBER@gcp-sa-notebooks\u2026']),\n    N('spec', 860, 80, 390, 100, 'vm', 'The instance', ['a standard machine type \u00b7 shielded VM (vTPM + integrity monitoring)', 'labels: notebooks-product=workbench-instances', 'tags: deeplearning-vm, notebook-instance']),\n    N('bootd', 860, 200, 180, 126, 'disk', 'Boot disk', ['INSTANCE-boot', 'size you choose \u00b7 pd-standard', 'cloned from the image', 'autoDelete: true']),\n    N('datad', 1070, 200, 180, 126, 'disk', 'Data disk', ['INSTANCE-data-', 'workspace', 'pd-standard (blank)', 'autoDelete: true']),\n    N('nic', 860, 346, 180, 110, 'svc', 'nic0', ['network: default', 'a regional subnet', 'internal IP', '+ ephemeral external IP']),\n    N('meta', 1070, 346, 180, 110, 'meta', 'Metadata (~two dozen keys)', ['custom-container-payload', 'proxy-* \u00b7 idle-timeout', 'user-data \u2192 cloud-config', 'report-event-url \u2026']),\n    N('sacct', 860, 476, 390, 70, 'svc', 'Attached service account', ['PROJECT_NUMBER-compute@developer.gserviceaccount.com', 'scopes: cloud-platform, userinfo.email']),\n  ],\n  frames: [\n    {id: 'proj', x: 820, y: 16, w: 470, h: 690, label: 'Your project \u00b7 a zone', lx: 836, ly: 36},\n    {id: 'vmf', x: 840, y: 50, w: 430, h: 520, label: 'The VM', lx: 856, ly: 70},\n  ],\n  labels: [],\n  edges: [\n    E('user_nb', [[210, 72], [250, 72]]),\n    E('nb_sa', [[480, 82], [520, 82]]),\n    E('nb_lro', [[365, 124], [365, 190]], 'operation', [372, 162]),\n    E('lro_user', [[250, 222], [115, 222], [115, 104]], 'polls', [124, 214]),\n    E('sa_compute', [[650, 124], [650, 190]], 'API call', [658, 162]),\n    E('comp_spec', [[780, 232], [800, 232], [800, 130], [860, 130]]),\n    E('img_boot', [[480, 376], [815, 376], [815, 263], [860, 263]], 'sourceImage', [520, 370]),\n    E('comp_ops', [[650, 274], [650, 450]], 'recorded', [658, 300]),\n  ],\n  steps: [\n    ST('a0', 't = 0', 'Clean slate', {n: ['user'], e: [], fr: ['proj']}, ['user'],\n      ['Your project has no instance and no disks for this Workbench yet.', 'The only thing that exists is a request you are about to send.', 'This scene follows it through the <b>Notebooks API<\/b> i